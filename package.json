{
  "name": "akshay-borse-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "compile:resume": "node scripts/compile-resume.mjs",
    "build": "tsc -b && vite build && node scripts/copy-404.mjs && node scripts/verify-dist.mjs && node scripts/check-bundle-size.mjs",
    "build:docs": "npm run build && node scripts/sync-docs.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "validate": "node scripts/validate.mjs",
    "verify:kg": "node scripts/verify-knowledge-graph.mjs",
    "verify:arsenal": "node scripts/verify-arsenal.mjs",
    "context:init": "node scripts/run-context.mjs init",
    "context:index": "node scripts/run-context.mjs index",
    "context:summarize": "node scripts/run-context.mjs summarize",
    "context:graph": "node scripts/run-context.mjs graph",
    "context:doctor": "node scripts/run-context.mjs doctor",
    "context:refresh": "node scripts/run-context.mjs index && node scripts/run-context.mjs summarize && node scripts/run-context.mjs graph",
    "agent:task": "tsx tools/autoreview/src/cli.ts agent-task",
    "agent:context": "tsx tools/autoreview/src/cli.ts agent-context",
    "agent:finish": "tsx tools/autoreview/src/cli.ts agent-finish",
    "review:start": "tsx tools/autoreview/src/cli.ts session-start",
    "review:status": "tsx tools/autoreview/src/cli.ts session-status",
    "review:scope": "tsx tools/autoreview/src/cli.ts scope",
    "review:run": "tsx tools/autoreview/src/cli.ts review --mode fast",
    "review:fast": "tsx tools/autoreview/src/cli.ts review --mode fast",
    "review:thorough": "tsx tools/autoreview/src/cli.ts review --mode thorough",
    "review:visual": "tsx tools/autoreview/src/cli.ts review --checks visual",
    "review:animation": "tsx tools/autoreview/src/cli.ts review --checks animation",
    "review:accessibility": "tsx tools/autoreview/src/cli.ts review --checks accessibility",
    "review:responsive": "tsx tools/autoreview/src/cli.ts review --checks responsive",
    "review:cross-browser": "tsx tools/autoreview/src/cli.ts review --checks cross-browser",
    "review:baseline": "tsx tools/autoreview/src/cli.ts review --checks baseline",
    "review:report": "tsx tools/autoreview/src/cli.ts report",
    "review:finish": "tsx tools/autoreview/src/cli.ts session-finish",
    "review:test": "vitest run tools/autoreview",
    "memory:add": "tsx tools/autoreview/src/cli.ts memory-add",
    "memory:list": "tsx tools/autoreview/src/cli.ts memory-list",
    "memory:search": "tsx tools/autoreview/src/cli.ts memory-search",
    "memory:review": "tsx tools/autoreview/src/cli.ts memory-review",
    "memory:compact": "tsx tools/autoreview/src/cli.ts memory-compact",
    "memory:reindex": "tsx tools/autoreview/src/cli.ts memory-reindex",
    "review:baseline:approve": "tsx tools/autoreview/src/cli.ts baseline-approve",
    "review:baseline:list": "tsx tools/autoreview/src/cli.ts baseline-list",
    "review:baseline:diff": "tsx tools/autoreview/src/cli.ts baseline-diff",
    "review:baseline:remove": "tsx tools/autoreview/src/cli.ts baseline-remove",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "framer-motion": "^12.40.0",
    "lenis": "^1.3.25",
    "marked": "^15.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.4.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.9",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.23.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
